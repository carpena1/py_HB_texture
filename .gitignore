.venv/
__pycache__/
*.pyc
.DS_Store
~$*
# 80 MB raw GSHP file — download via prepare_gshp.py (Zenodo 6640246).
data/WRC_dataset_surya_et_al_2021_final.csv
# Raw UNSODA Access database — rebuild data/unsoda_reference.csv with
# prepare_unsoda.py (Ag Data Commons / figshare 24851832).
data/unsoda_raw/
data/unsoda.zip
# Multi-GB NCSS/KSSL Lab Data Mart snapshot — rebuild data/kssl_reference.csv
# with prepare_kssl.py (public domain, USDA-NRCS).
data/kssl_raw/
# ---------------------------------------------------------------------------
# ESDAC / European Soil Database material (HYPRES, SPADBE, licence and access
# documents) is licensed to the individual registrant. The agreement states
# that under no circumstances may these data be passed to third parties, and
# they may not be used for commercial gain. NOTHING derived from them may be
# committed to this public repository.
# ---------------------------------------------------------------------------
data/hypres_reference.csv
data/hypres_raw/
data/HYPRES*
data/hypres*
data/Hypres*
data/spadbe*
data/SPADBE*
data/Spadbe*
data/ESDAC*
data/esdac*
data/ESDB*
data/soilDB*
data/soildb*
data/sgdbe*
data/SGDBE*
data/*licen[cs]e*
data/unsoda_ht.csv
data/unsoda_general.csv
data/unsoda_props.csv
data/unsoda_psd.csv
# Hohenbrink et al. (2023) raw distribution (23 MB) — rebuild
# data/hohenbrink_reference.csv with prepare_hohenbrink.py.
data/Hohenbrink_raw/

# Laikipia, Kenya soils (the user's own team, unpublished; exact site
# locations and a submitted manuscript). Not distributed.
data/willard_raw/
data/willard_reference.csv

# Canary Islands volcanic ("sorriba") soils: Armas-Espinel et al. (2003) paper
# and the source dissertation (copyright), and the points digitised from it.
# The derived data/armas_reference.csv is distributed.
data/armas_raw/
data/armas_points.csv

# Smithsonian Global Volcanism Program volcano lists (downloaded reference
# data, used to flag volcanic soils); rebuilt on demand.
data/volcanoes_raw/

# Metadata document for GSHP's Florida_database (Florida Soil Characterization
# Data, UF); a third-party source document, not distributed.
data/FL_soils_GSHP/

# Babaeian's raw files, including the published SSSAJ paper (copyright). The
# derived data/babaeian_zanjanrood_reference.csv may be distributed: the data owner
# shared it for that.
data/babaeian_Zanjanrood_raw/
# ---------------------------------------------------------------------------
# EU-HYDI (European Hydropedological Data Inventory) is consortium-restricted:
# per EUR 26053 EN the intellectual property stays with the individual data
# providers. Neither the raw database nor anything derived from it may be
# committed to this public repository until redistribution terms are agreed.
# ---------------------------------------------------------------------------
data/euhydi_raw/
data/euhydi_reference.csv
data/euhydi*
data/EUHYDI*
data/HYDI*

# A user's own lab-verified curves (add_local_data.py); private by default.
data/local_reference.csv

# Per-sample validation predictions (include EU-HYDI samples); aggregate figures only are committed.
figures/cache/

# Babaeian's Arizona soils (the data owner's spreadsheet and fit plots); the
# derived data/babaeian_az_reference.csv is distributed.
data/babaeian_AZ_raw/
# Tong et al. (2024) Yellow River Basin download from PANGAEA (CC BY 4.0);
# the derived data/tong_reference.csv is distributable.
data/tong_raw/
# ANSIS (Australian National Soil Information System) query download; terms
# vary by data provider, so the raw download stays local.
data/ansis_raw/
# Canada National Pedon Database downloads (Open Government Licence - Canada)
data/npdb_raw/
# CSIRO Boorowa Farm soil physics (CC BY-NC-SA 4.0): raw and derived stay local
data/boorowa_raw/
data/boorowa_reference.csv
# Per-soil reports for external test sets.
figures/external/babaeian_az/
figures/external/willard/
figures/external/boorowa/

# Third-party soil registries downloaded to resolve volcanic-soil flags
# (Africa Soil Profiles Database, Russian soil register). Rebuilt on demand.
data/soil_registries_raw/

# Volcanic inventory (prepare_volcanic.py): network/registry caches, and the
# flags of restricted or unpublished layers. data/volcanic_flags.csv (public
# layers only) may be distributed.
data/volcanic_raw/
data/volcanic_flags_restricted.csv

# Measured retention points dumped by the prepare scripts for the IvG refits
# (ivg_fits.py); rebuilt on demand from each source's raw data.
data/kssl_points.csv
data/hohenbrink_points.csv
